<!-- Client override of the shared view_connect (same name → replaces it in the client app only). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Warning banner (gone unless there is something to warn about) -->
    <LinearLayout
        android:id="@+id/connectBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_banner"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="11dp"
        android:paddingVertical="10dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_warning_fill"
            android:tint="@color/ls_error" />

        <TextView
            android:id="@+id/bannerText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/ls_text"
            android:textSize="11.5sp" />

        <ImageView
            android:id="@+id/bannerDismiss"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/cd_dismiss"
            android:src="@drawable/ic_x"
            android:tint="@color/ls_text_dim" />
    </LinearLayout>

    <!-- Circle fills the remaining vertical space -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="264dp">

        <goodvin.locsync.shared.PowerOrbView
            android:id="@+id/powerOrb"
            android:layout_width="264dp"
            android:layout_height="264dp"
            android:layout_gravity="center"
            android:clickable="true"
            android:focusable="true" />
    </FrameLayout>

    <!-- Status block -->
    <TextView
        android:id="@+id/statusLine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:textColor="@color/ls_text_muted"
        android:textSize="19sp" />

    <TextView
        android:id="@+id/statusSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:textColor="@color/ls_text_muted"
        android:textSize="12sp" />

    <!-- "Is the navigator getting a position?" — the one thing the driver needs to know -->
    <LinearLayout
        android:id="@+id/navCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginHorizontal="14dp"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="11dp">

        <View
            android:id="@+id/navDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/dot_accent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/navTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/ls_text"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/navDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/ls_text_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- The phone's battery and heat (shown when the server reports it) -->
    <LinearLayout
        android:id="@+id/phoneCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="14dp"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="11dp"
        android:visibility="gone">

        <View
            android:id="@+id/phoneDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/dot_accent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/phoneTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/ls_text"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/phoneDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/ls_text_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Car signals from the head unit: Motion / Energy / Temperatures (shown when available) -->
    <LinearLayout
        android:id="@+id/carCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="14dp"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="11dp"
        android:visibility="gone">

        <View
            android:id="@+id/carDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/dot_accent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/carTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/ls_text"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/carDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/ls_text_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 2×2 tiles: speed, accuracy / satellites, data freshness. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="14dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <include layout="@layout/tile_stat" android:id="@+id/tileSpeed"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />

        <Space android:layout_width="8dp" android:layout_height="1dp" />

        <include layout="@layout/tile_stat" android:id="@+id/tileAccuracy"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="14dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <include layout="@layout/tile_stat" android:id="@+id/tileSats"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />

        <Space android:layout_width="8dp" android:layout_height="1dp" />

        <include layout="@layout/tile_stat" android:id="@+id/tileFresh"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="14dp" />
</LinearLayout>
